import numpy as np

# 1. Input Data
harga = [10, 20, 40, 60, 80]
tiket = [500, 420, 300, 210, 100]

# 2. Fungsi hitung Min-Max Normalization
def tampil_minmax(nama, data):
    min_val = min(data)
    max_val = max(data)

    print(f"Min-Max {nama}:")
    for x in data:
        # Rumus: (x - min) / (max - min)
        norm = (x - min_val) / (max_val - min_val)
        print(f"{norm:.9f}")
    print()

# 3. Eksekusi
